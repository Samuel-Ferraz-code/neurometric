# =====================================================================
# NeuroMetric — configuração local
# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).
# =====================================================================

# Porta do servidor e endereço usado nos links de redefinição de senha
PORT=3000
BASE_URL=http://localhost:3000

# development | production  (em production o cookie de sessão exige HTTPS)
NODE_ENV=development

# Arquivo do banco SQLite (criado automaticamente na primeira execução)
DATABASE_FILE=data/neurometric.sqlite

# Banco de questões (JSON convertido de "Questões Qi_so10.docx")
QUESTION_BANK_FILE=data/questoes.json

# Parâmetros normativos para a estimativa EXPERIMENTAL de QI (opcional).
# Sem este arquivo, o QI aparece como "indisponível".
NORMS_FILE=data/normas.json

# Duração padrão da tela de memorização (segundos), quando a questão não define a sua
MEMORIZATION_SECONDS=8

# Sessão: duração da sessão comum (horas) e do "Lembrar de mim" (dias)
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30

# Limite de tentativas de login (janela em minutos, falhas por e-mail e por IP)
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_PER_EMAIL=5
LOGIN_MAX_PER_IP=20

# Validade do link de redefinição de senha (minutos).
# Sem servidor de e-mail, o link é exibido no terminal em modo development.
RESET_TOKEN_MINUTES=30
RESET_LINK_TO_CONSOLE=true

# Login com Google (OAuth 2.0 / OpenID Connect).
# Deixe em branco para manter o botão desativado. Passo a passo no README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
